{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Script with UTF-8",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            },
            "python": "${defaultInterpreterPath}"
        },
        {
            "name": "Validate (05_validate.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/05_validate.py",
            "args": ["${input:subject}"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "Assemble (06_assemble.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/06_assemble.py",
            "args": ["${input:subject}"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        }
    ],
    "inputs": [
        {
            "id": "subject",
            "description": "Subject name (e.g., science, accounting)",
            "type": "pickString",
            "options": [
                "science",
                "accounting",
                "math",
                "english",
                "bangla"
            ],
            "default": "science"
        }
    ]
}
